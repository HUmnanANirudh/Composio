 "n": 100,
 "headlines": [
  {
   "fig": "75%",
   "text": "of apps (75 of 100) let a developer get working credentials alone; 25 are gated by a paid plan, an approval step, or sales."
  },
  {
   "fig": "82%",
   "text": "accept a static API key or token, the most common scheme; 68% accept OAuth 2.0, and 53 offer both."
  },
  {
   "fig": "Communications and Messaging",
   "text": "is the most open category (100% self-serve); Support and Helpdesk is the most gated (50% self-serve)."
  },
  {
   "fig": "29",
   "text": "apps are held back by the most common blocker: paid plan required."
  },
  {
   "fig": "10",
   "text": "easy wins: self-serve and buildable today, with no Composio toolkit yet. 7 need outreach or a partnership."
  },
  {
   "fig": "87",
   "text": "of 100 vendors already ship an official MCP server."
  }
 ],
